# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram Ads API access token from https://ads.telegram.org/account/api
TELEGRAM_ADS_ACCESS_TOKEN=

# Optional default advertiser account. If empty, the token's current account is used.
TELEGRAM_ADS_ACCOUNT_ID=

# Ads API base URL (override only for a proxy / mock)
TELEGRAM_ADS_API_BASE_URL=https://promoteapi.telegram.org

# Optional Bot API base (local Bot API server)
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# Comma-separated Telegram user ids allowed to use the bot. Empty = allow everyone.
BOT_ALLOWED_USER_IDS=

# Logging
LOG_LEVEL=INFO

# FSM persistence file (created automatically)
BOT_FSM_PATH=data/fsm.sqlite

# --- Proposals agent (agent/) ---
# 1 = only log what would be sent to Ads API (default). Live mode also needs FIRST_LIVE_MAX_BUDGET.
ADS_DRY_RUN=1
AGENT_DB_PATH=data/agent.sqlite
# Comma-separated promote_url allow-list (I5)
AGENT_PROMOTE_URL_ALLOWLIST=https://t.me/premierleaguedaily
# [VERIFY] includes_ads (conservative default) | excludes_ads — run scripts/agent_recon.py first
AGENT_BALANCE_SEMANTICS=includes_ads
# Owner inputs [ASK]: empty = not set; the agent refuses to plan/act and says which value is missing
HURDLE_CPA_TON=
EXPLORE_SHARE=
MAX_LOSS_PER_HYPOTHESIS=
MAX_ACTIVE_EXPERIMENTS=
FIRST_LIVE_MAX_BUDGET=
LLM_DAILY_USD_CAP=
# Plan defaults
MAX_PENDING_PROPOSALS=3
PROPOSAL_TTL_HOURS=12
